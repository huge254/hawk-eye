{
  "uid": "hawk-node-overview",
  "title": "鹰眼 · 主机与 MySQL 监控总览",
  "description": "鹰眼统一可观测平台 —— 主机资源、网络磁盘与项目一 MySQL 的实时健康视图",
  "tags": ["hawk-eye", "node", "mysql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "📊 资源总览",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "内存使用率",
      "description": "主机物理内存占用比例，>70% 黄色预警，>85% 红色告警",
      "id": 1,
      "gridPos": { "h": 8, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "内存" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0891b2", "value": null },
              { "color": "#f59e0b", "value": 70 },
              { "color": "#f43f5e", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "gauge",
      "title": "CPU 使用率",
      "description": "主机 CPU 平均占用比例，>70% 黄色预警，>90% 红色告警",
      "id": 2,
      "gridPos": { "h": 8, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0891b2", "value": null },
              { "color": "#f59e0b", "value": 70 },
              { "color": "#f43f5e", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "gauge",
      "title": "根分区使用率",
      "description": "根目录磁盘空间占用比例，>75% 黄色预警，>90% 红色告警",
      "id": 3,
      "gridPos": { "h": 8, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "磁盘" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0891b2", "value": null },
              { "color": "#f59e0b", "value": 75 },
              { "color": "#f43f5e", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "MySQL 健康概览",
      "description": "存活状态 / 当前连接数 / 每秒查询数 / 运行时长",
      "id": 4,
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"mysqld\"}", "legendFormat": "状态" },
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "连接数" },
        { "expr": "round(rate(mysql_global_status_queries[5m]))", "legendFormat": "QPS" },
        { "expr": "mysql_global_status_uptime", "legendFormat": "运行时长" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#0891b2" },
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "#0891b2", "value": null } ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "状态" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "index": 1, "color": "#f43f5e" }, "1": { "text": "UP", "index": 0, "color": "#10b981" } } }
                ]
              },
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [ { "color": "#f43f5e", "value": null }, { "color": "#10b981", "value": 1 } ] }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "运行时长" },
            "properties": [ { "id": "unit", "value": "s" } ]
          },
          {
            "matcher": { "id": "byName", "options": "QPS" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8b5cf6" } } ]
          }
        ]
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "text": { "titleSize": 10, "valueSize": 18 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "📈 主机资源趋势",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "内存使用趋势",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "已用" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "可用" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "已用" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#f59e0b" } }] },
          { "matcher": { "id": "byName", "options": "可用" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0891b2" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU 使用率趋势",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "fixed", "fixedColor": "#8b5cf6" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "💾 磁盘与网络",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "磁盘读写速率",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total[2m])", "legendFormat": "读 {{device}}" },
        { "expr": "rate(node_disk_written_bytes_total[2m])", "legendFormat": "写 {{device}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 14,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "网络流量",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[2m])", "legendFormat": "入 {{device}}" },
        { "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[2m])", "legendFormat": "出 {{device}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 14,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "🐬 MySQL 性能",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "连接数与慢查询",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "当前连接数" },
        { "expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "慢查询速率(次/秒)" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 14,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "当前连接数" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0891b2" } }] },
          { "matcher": { "id": "byName", "options": "慢查询速率(次/秒)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#f43f5e" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "每秒查询数 (QPS)",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[5m])", "legendFormat": "QPS" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "fixed", "fixedColor": "#10b981" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
